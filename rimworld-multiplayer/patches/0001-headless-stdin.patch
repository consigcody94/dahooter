+if (Console.IsInputRedirected)
+{
+    // Headless mode: stdin is a pipe, a file, or closed (docker without -t, systemd, nohup, CI).
+    // Console.KeyAvailable throws InvalidOperationException in that case, so read whole lines on a
+    // background thread instead and let the main thread just wait for the server to stop.
+    ServerLog.Log("Console input is redirected; running headless. Send commands on stdin or use SIGTERM to stop.");
+    var inputThread = new Thread(() =>
     {
+        try
+        {
+            string? line;
+            while (server.running && (line = Console.In.ReadLine()) != null)
+            {
+                var cmd = line.Trim();
+                if (cmd.Length == 0) continue;
+                server.Enqueue(() => server.HandleChatCommand(consoleSource, cmd));
+                if (cmd == stopCmd) RequestStop("stdin");
+            }
+        }
+        catch (Exception e)
+        {
+            ServerLog.Error($"Console input thread ended: {e.Message}");
+        }
+        // EOF on stdin is normal when nothing is attached; the server keeps running until stopped.
+    }) { Name = "Console input", IsBackground = true };
+    inputThread.Start();
+
+    while (server.running)
         Thread.Sleep(50);
+}
+else
