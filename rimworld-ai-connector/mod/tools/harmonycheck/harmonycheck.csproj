<Project Sdk="Microsoft.NET.Sdk">
  <!-- Verifies that every string-named Harmony patch target and AccessTools lookup in the mod
       source exists in the RimWorld reference assemblies the mod was built against. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.*" />
  </ItemGroup>
</Project>
